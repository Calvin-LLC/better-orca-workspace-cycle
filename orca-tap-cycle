#!/usr/bin/env python3
"""Tap-cycle helper for Linux: Ctrl+digit jumps to Orca workspace N,
repeat-tap of the same digit cycles terminal tabs inside it.

Sticky by design: the helper remembers the last digit it was asked for.
Same digit again always cycles. A different digit always jumps. This
mirrors orca-tap-cycle.ahk (Windows/AutoHotkey v2) without needing a
timing window.

Hyprland calls this with one argument (the digit 1-9). The helper sends
the real chord to the focused Orca window via hyprctl send_shortcut:

  orca-tap-cycle 3        # first tap:  Ctrl+Shift+3 (workspace 3)
  orca-tap-cycle 3        # second tap: Ctrl+Page_Down (next terminal tab)
  orca-tap-cycle 4        # different:  Ctrl+Shift+4 (workspace 4)

Outside Orca focus the helper re-emits the plain key untouched so other
apps keep their Ctrl+digit behavior.

State lives in ~/.local/state/orca-tap-cycle.json (last digit only).
Requires: Hyprland (hyprctl), Orca with win32/linux keybindings at
workspace.selectByIndex=Mod+Shift+1 and default tab.nextTerminal.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys

STATE_PATH = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.join(os.path.expanduser("~"), ".local", "state")),
    "orca-tap-cycle.json",
)
ORCA_CLASSES = ("orca", "orca-ide")


def active_class() -> str:
    try:
        out = subprocess.run(
            ["hyprctl", "activewindow", "-j"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if out.returncode != 0:
        return ""
    try:
        data = json.loads(out.stdout or "{}")
    except json.JSONDecodeError:
        return ""
    for key in ("initialClass", "class"):
        value = data.get(key)
        if value:
            return str(value)
    return ""


def in_orca() -> bool:
    cls = active_class().lower()
    return any(tag in cls for tag in ORCA_CLASSES)


def send_shortcut(mods: str, key: str) -> None:
    # Hyprland 0.55+ evaluates `hyprctl dispatch` args as Lua, so the
    # legacy string form (`hyprctl dispatch sendshortcut CTRL, 1, active`)
    # dies with a parse error. Go through `hyprctl eval` with the Lua
    # dispatcher instead; probed working on Hyprland 0.56.2.
    # window='class:orca' targets the Orca window even when it is not
    # focused (bare sends land on whatever has focus; address and
    # plain-class forms report "window not found").
    snippet = (
        "hl.dispatch(hl.dsp.send_shortcut({mods='"
        + mods
        + "', key='"
        + key
        + "', window='class:orca'}))"
    )
    subprocess.run(["hyprctl", "eval", snippet], capture_output=True, timeout=5)


def load_state() -> dict:
    try:
        with open(STATE_PATH, encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state: dict) -> None:
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(state, handle)
        os.replace(tmp, STATE_PATH)
    except OSError as err:
        print(f"orca-tap-cycle: could not write state: {err}", file=sys.stderr)


def main(argv: list[str]) -> int:
    if len(argv) != 2 or len(argv[1]) != 1 or not argv[1].isdigit():
        print(f"usage: {os.path.basename(argv[0])} <digit 1-9>", file=sys.stderr)
        return 2
    digit = argv[1]
    if not in_orca():
        # Not Orca: put the key back so the focused app behaves normally.
        send_shortcut("CTRL", digit)
        return 0
    state = load_state()
    if state.get("digit") == digit:
        send_shortcut("CTRL", "Page_Down")
    else:
        send_shortcut("CTRL SHIFT", digit)
        state["digit"] = digit
        save_state(state)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
