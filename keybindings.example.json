{
  "version": 1,
  "keybindings": {
    "worktree.quickOpen": []
  },
  "platforms": {
    "darwin": {},
    "linux": {
      "workspace.selectByIndex": [
        "Mod+Shift+1"
      ],
      "tab.nextTerminal": [
        "Ctrl+PageDown"
      ]
    },
    "win32": {
      "tab.selectByIndex": [
        "Mod+1"
      ],
      "workspace.selectByIndex": [
        "Mod+Shift+1"
      ],
      "tab.nextSameType": [
        "Mod+Shift+BracketRight"
      ],
      "tab.previousSameType": [
        "Mod+Shift+BracketLeft"
      ],
      "tab.nextAllTypes": [
        "Mod+Alt+BracketRight"
      ],
      "tab.previousAllTypes": [
        "Mod+Alt+BracketLeft"
      ],
      "tab.nextTerminal": [
        "Ctrl+PageDown"
      ]
    }
  }
}
