#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys

STATE_PATH = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.join(os.path.expanduser("~"), ".local", "state")),
    "orca-tap-cycle.json",
)


def active_class() -> str:
    try:
        out = subprocess.run(
            ["hyprctl", "activewindow", "-j"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if out.returncode != 0:
        return ""
    try:
        data = json.loads(out.stdout or "{}")
    except json.JSONDecodeError:
        return ""
    for key in ("initialClass", "class"):
        value = data.get(key)
        if value:
            return str(value)
    return ""


def in_orca() -> bool:
    return "orca" in active_class().lower()


def send_shortcut(mods: str, key: str) -> None:
    # Hyprland's Lua config rejects the legacy `hyprctl dispatch` string form.
    snippet = (
        "hl.dispatch(hl.dsp.send_shortcut({mods='"
        + mods
        + "', key='"
        + key
        + "', window='class:orca'}))"
    )
    subprocess.run(["hyprctl", "eval", snippet], capture_output=True, timeout=5)


def load_state() -> dict[str, str]:
    try:
        with open(STATE_PATH, encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state: dict[str, str]) -> None:
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        tmp = STATE_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(state, handle)
        os.replace(tmp, STATE_PATH)
    except OSError as err:
        print(f"orca-tap-cycle: could not write state: {err}", file=sys.stderr)


def main(argv: list[str]) -> int:
    if len(argv) != 2 or len(argv[1]) != 1 or not argv[1].isdigit():
        print(f"usage: {os.path.basename(argv[0])} <digit 1-9>", file=sys.stderr)
        return 2
    if not in_orca():
        return 0
    digit = argv[1]
    state = load_state()
    if state.get("digit") == digit:
        send_shortcut("CTRL", "Page_Down")
    else:
        send_shortcut("CTRL SHIFT", digit)
        state["digit"] = digit
        save_state(state)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
